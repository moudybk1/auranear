# Salin ke services/.env. JANGAN commit file .env.
NETWORK=testnet
# RPC cadangan dipakai otomatis bila yang utama gagal. Mainnet: https://rpc.mainnet.fastnear.com dan https://free.rpc.fastnear.com
RPC_URL=https://rpc.testnet.fastnear.com
RPC_URL_FALLBACK=https://test.rpc.fastnear.com
CONTRACT_ID=perps.yourname.testnet
MARKETS=BTC-USD,ETH-USD,NEAR-USD

# Rahasia (format ed25519:...). Ambil dari ~/.near-credentials/<network>/
ORACLE_ACCOUNT_ID=oracle.yourname.testnet
ORACLE_PRIVATE_KEY=
KEEPER_ACCOUNT_ID=keeper.yourname.testnet
KEEPER_PRIVATE_KEY=

# Oracle: dorong saat harga bergerak >= PRICE_PUSH_BPS, atau tiap PRICE_PUSH_MAX_SEC
PRICE_PUSH_BPS=10
PRICE_PUSH_MAX_SEC=300
ORACLE_POLL_SEC=5

# Keeper
KEEPER_INTERVAL_SEC=15

# HTTP: hanya GET /health
PORT=8787
CORS_ORIGIN=http://localhost:3000
