# Salin ke web/.env.local. Tidak ada rahasia di sini: semua nilai tampil di browser.
# Tanpa NEXT_PUBLIC_CONTRACT_ID (atau selama masih berisi "yourname") app berjalan dalam mode demo:
# kontrak disimulasikan di browser, tidak ada transaksi yang dikirim.
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ID=perps.yourname.testnet
# testnet: tusd.yourname.testnet | mainnet (USDC native): 17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
NEXT_PUBLIC_USDC_ID=tusd.yourname.testnet
# Opsional: daftar RPC dipisah koma, dicoba berurutan. Bawaan: FastNEAR sesuai jaringan.
# NEXT_PUBLIC_RPC_URL=https://rpc.testnet.fastnear.com
